cabal-version:      2.4
name:               des-stego
version:            0.1.0.0
synopsis:           DES-based steganography tool (hand-rolled DES implementation)
build-type:         Simple

executable des-stego
    main-is:          Main.hs
    hs-source-dirs:   src
    other-modules:    DES
                    , BinaryOperation
                    , ImageTransformation
                    , IoOperations
                    , ToPixels
                    , WordOperations
    build-depends:    base >=4.7 && <5
    default-language: Haskell2010
    ghc-options:      -O2
